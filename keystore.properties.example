# Copy to keystore.properties (gitignored) and fill in your release keystore details.
# Create a keystore once and back it up — losing it means you cannot update the Play app.
#
# Example:
#   keytool -genkeypair -v -keystore app/lingualearn-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias lingualearn

storeFile=app/lingualearn-release.jks
storePassword=REPLACE_ME
keyAlias=lingualearn
keyPassword=REPLACE_ME
